# ---------------------------------------------------------------------------
# AI SOC Workbench — environment configuration template
# Copy this file to .env and fill in values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soc_workbench
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://soc_admin:change-me@db:5432/soc_workbench

# --- Redis (cache / rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_SINGLE_USER_MODE=true

# --- AI / LLM provider (provider-agnostic) ---
# Options: mock | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=mock-soc-analyst-v1
# Only required if LLM_PROVIDER is not "mock". Never hard-code — leave blank here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Threat Intelligence adapters ---
# Set to "true" to make live calls; false (default) uses deterministic mocked responses.
TI_USE_LIVE_PROVIDERS=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
TI_CACHE_TTL_SECONDS=3600
TI_RATE_LIMIT_PER_MINUTE=4

# --- MCP/API Security Gateway (commercial modules) ---
# Set to "true" to let approved GitHub PR creation / secret-provider revocation
# make real external calls. false (default) simulates every tool call — see
# docs/commercial-modules-proposal.md and app/services/mcp_gateway.py.
EXTERNAL_TOOLS_LIVE_MODE=false

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=localhost
N8N_PORT=5678
BACKEND_WEBHOOK_TOKEN=change-me-shared-secret

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
